DATA_AGENT_ADAPTER=http
DATA_PLATFORM_BASE_URL=https://data-platform.example.com
DATA_PLATFORM_TOKEN=replace-with-your-token
DATA_PLATFORM_TIMEOUT_SECONDS=10
DATA_PLATFORM_USER_AGENT=data-agent/0.2

DATA_AGENT_LLM_ENABLED=false
DATA_AGENT_LLM_PROVIDER=openai
DATA_AGENT_LLM_MODEL=gpt-5
DATA_AGENT_LLM_API_KEY=replace-with-your-llm-api-key
DATA_AGENT_LLM_BASE_URL=https://api.openai.com/v1
DATA_AGENT_LLM_TEMPERATURE=0
DATA_AGENT_LLM_TIMEOUT_SECONDS=30
DATA_AGENT_LLM_MIN_CONFIDENCE=0.55

DATA_AGENT_CHAT_IDLE_TIMEOUT_SECONDS=600
DATA_AGENT_CHAT_TIMEOUT_WARNING_SECONDS=120
